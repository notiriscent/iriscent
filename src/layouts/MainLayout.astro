---

import { Font } from 'astro:assets';

---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://unpkg.com/lenis@1.3.15/dist/lenis.css">
    <title>iriscent</title>
</head>
<body>
    <Font cssVariable='--font-dm-sans' preload />
    <slot />
    <style>
        body, html {
            scroll-behavior: smooth;
            width: 100vw;
            height: 100vh;
            margin: 0;
            background-color: #121217;
            color: #fff;
            overflow-x: hidden;
        }
    </style>
    <script type="module">
        import Lenis from 'https://unpkg.com/lenis@1.3.15/dist/lenis.mjs'

        const lenis = new Lenis({
            smooth: true,
            lerp: 0.1
        })

        function raf(time) {
            lenis.raf(time)
            requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
    </script>
</body>
</html>